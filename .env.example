# Copy to .env and edit. Shell environment variables override these.

# CCTV stream (HLS .m3u8 / RTSP) or a local video file.
# Default: Semarang PANTAUSEMAR "Karangayu ke timur" (2688x1520).
CCTV_URL=https://livepantau.semarangkota.go.id/10039517-6c83-4832-bc98-846624b9df3d/index.m3u8

# Detection zone. OCR only runs on vehicles whose bottom-center is inside.
#   auto (or empty)    full-width band from 25% to 85% of the frame height, any resolution
#   x,y x,y ...        manual polygon in source pixels, e.g. for Karangayu (2688x1520):
#                      ZONE=0,560 2688,560 2688,1150 0,1150
# The zone in use is printed at startup, so you can copy auto's value and tweak it.
ZONE=auto
